#!/usr/bin/env bash
# Check what is being pushed against CONTRIBUTING.md before it leaves:
# branch names follow <type>/<summary> and tags are SemVer (vX.Y.Z).
# Bypass in an emergency with --no-verify.

branch_re='^(main|dev|hotfix/[a-z0-9._-]+|(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)/[a-z0-9._-]+)$'
tag_re='^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'
zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deletions are fine
  case "$remote_ref" in
    refs/heads/*)
      name="${remote_ref#refs/heads/}"
      if ! printf '%s' "$name" | grep -qE "$branch_re"; then
        echo "✗ Branch '$name' does not follow <type>/<summary> (e.g. feat/font-panel)." >&2
        status=1
      fi
      ;;
    refs/tags/*)
      name="${remote_ref#refs/tags/}"
      if ! printf '%s' "$name" | grep -qE "$tag_re"; then
        echo "✗ Tag '$name' is not a SemVer release tag (vX.Y.Z)." >&2
        status=1
      fi
      ;;
  esac
done

[ "$status" -ne 0 ] && echo "  See CONTRIBUTING.md." >&2
exit "$status"
