#!/usr/bin/env bash
# Validate the commit subject against Conventional Commits. See CONTRIBUTING.md.
# Enable with: git config core.hooksPath .githooks

msg_file="$1"
subject="$(grep -vE '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)"

# Let git's own machinery through untouched.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  {
    echo "✗ Commit message does not follow Conventional Commits."
    echo "  Subject: $subject"
    echo "  Expected: <type>(<scope>): <subject>   e.g. feat(editor): add ⌘B toggle"
    echo "  Types: feat fix perf refactor docs style test build ci chore revert"
    echo "  See CONTRIBUTING.md."
  } >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "✗ Subject line is ${#subject} chars; keep it ≤ 72." >&2
  exit 1
fi
